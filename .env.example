# Copy to .env and fill in, or export these in your shell.
# Nothing here is read automatically - backend/db/connection.py reads the
# process environment, so either export them or use a tool like direnv.

# Password for the local PostgreSQL role. The only required variable.
DB_PASSWORD=

# Optional: silences the HuggingFace rate-limit warning and speeds downloads.
# HF_TOKEN=

# Optional: move the ~1.5GB model cache off the default ~/.cache/huggingface.
# HF_HOME=
