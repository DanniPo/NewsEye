# Newseye server settings. On the server, copy this file to .env in the
# repository root and fill it in. .env is in .gitignore: never commit it.

# --- the address ---
# A domain name whose A record points at the server's IP address. Caddy gets
# the HTTPS certificate for it by itself on first start.
NEWSEYE_DOMAIN=newseye.example.com

# --- who can see it ---
# private: the whole site asks for a login (a trial with the supervisor and
# testers). public: anyone; read "Before going public" in deploy/README.md first.
NEWSEYE_ACCESS=private
NEWSEYE_LOGIN_USER=reviewer
# The login password's bcrypt hash (not the password), made with
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the password'
# Keep the single quotes: the hash contains $ signs.
NEWSEYE_LOGIN_HASH=''

# --- the database ---
# The pipeline's password, and the read-only API account's (at least 12
# characters). Long random strings: nobody types them.
DB_PASSWORD=
NEWSEYE_API_DB_PASSWORD=

# --- the schedule and backups ---
NEWSEYE_EVERY_HOURS=2
NEWSEYE_BACKUPS_KEPT=7
